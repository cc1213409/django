# Copy to .env for local customization. .env is ignored by Git.
# Set a different, private key before deploying outside local development.
DJANGO_SECRET_KEY=local-development-only-change-before-deploying
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.app.github.dev
DJANGO_DB_PATH=db.sqlite3
